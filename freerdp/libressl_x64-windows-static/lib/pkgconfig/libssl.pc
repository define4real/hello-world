prefix=${pcfiledir}/../..
#libssl pkg-config source file

exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: LibreSSL-libssl
Description: Secure Sockets Layer and cryptography libraries
Version: 4.0.0

Libs: "-L${libdir}" -lssl
Requires: libcrypto
Cflags: "-I${includedir}"
